build/
.gradle/
.idea/
*.iml
out/

# MSYS/Git-Bash crash dumps. Written into the working directory by bash.exe itself when its
# fork() emulation fails; they are a Windows toolchain artefact, never a build output, and one
# reached a commit before this line existed.
*.stackdump
.playwright-mcp/

# Design handoff bundle from Claude Design. A reference to read, not a source to build — the
# prototypes ship a design-tool runtime that must never enter this repository.
.designsystem/

# Subagent-driven-development scratch: ledgers, briefs, review packages. Git history is the record.
.superpowers/

# macOS Finder metadata. Written into any directory the Finder merely looks at, so it appears
# without anyone touching the repository and shows up as untracked noise in every status.
.DS_Store
